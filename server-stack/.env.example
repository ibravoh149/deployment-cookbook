# Copy to .env on the server and fill in. Never commit .env.

# The name pointing at the server (../cloudflare/). Without a domain: <ip-with-dashes>.sslip.io
DOMAIN=
# openssl rand -hex 32  (hex: a base64 "/" or "+" breaks the database URL)
POSTGRES_PASSWORD=

# Off-site backups to Cloudflare R2 (../r2/, ../backups/). Leave empty to keep backups on the server only.
# R2_ENDPOINT is https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Your app's own settings go below; the app service reads this whole file.
